# ==============================================================================
# FaruTech Design System (@farutech/design-system) - Autenticacion de Registro
# ==============================================================================
# Este archivo documenta las variables requeridas para autenticar la publicacion
# y descarga del paquete @farutech/design-system como libreria versionada.
# ==============================================================================

# ------------------------------------------------------------------------------
# OPCION 1: GitHub Packages (Recomendado para paquetes de organizacion @farutech)
# ------------------------------------------------------------------------------
# 1. Ve a GitHub: Settings -> Developer Settings -> Personal Access Tokens -> Tokens (classic)
# 2. Genera un token con permisos:
#    - write:packages (para publicar nuevas versiones)
#    - read:packages  (para instalar el paquete en CI/CD o apps consumidoras)
#    - repo           (si el repositorio es privado)
# 3. Asigna el token a continuacion:
NODE_AUTH_TOKEN=ghp_tu_token_personal_de_github_aqui
GITHUB_TOKEN=ghp_tu_token_personal_de_github_aqui

# ------------------------------------------------------------------------------
# OPCION 2: Registro Publico npm (npmjs.com)
# ------------------------------------------------------------------------------
# 1. Inicia sesion en https://www.npmjs.com/
# 2. Ve a Access Tokens -> Generate New Token -> Automation
# 3. Asigna el token a continuacion:
NPM_TOKEN=npm_tu_token_de_npmjs_aqui
