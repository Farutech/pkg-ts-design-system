# =========================================================
# FaruTech TypeScript Design System · .gitignore consolidado
# =========================================================

# ---------- Dependencias ----------
node_modules/
**/node_modules/
.pnp
.pnp.js

# ---------- Compilación y Builds ----------
dist/
**/dist/
dist-ssr/
build/
**/build/
storybook-static/
**/storybook-static/
*.tsbuildinfo
*.tgz
packages/*.tgz

# ---------- Vite / Cache ----------
.vite/
.vite-temp/
.turbo/
.cache/

# ---------- Pruebas y Reportes ----------
coverage/
**/coverage/
.nyc_output/
allure-results/
**/allure-results/
allure-report/
**/allure-report/
evidence/
**/evidence/
TestResults/
**/TestResults/
playwright-report/
**/playwright-report/
blob-report/
.playwright/

# ---------- Entorno y Secretos ----------
.env
.env.*
!.env.example
*.local.env

# ---------- Editor y Sistema ----------
.vscode/
.idea/
.vs/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.user
*.swp
*.tmp
*.bak
*scratch*

# ---------- Logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
